# Local development. Do not put live credentials in Git.
PORT=8080
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:8080
DB_PATH=./data/smetra.sqlite3

# Production serverless PostgreSQL, private schema. Leave DATABASE_URL empty locally for SQLite.
DATABASE_URL=
# Restricted login for authenticated workspace requests; required on Vercel.
RUNTIME_DATABASE_URL=
SMETRA_DB_SCHEMA=smetra

# Russian identity providers; configure exact callbacks in provider consoles.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
RUSTORE_URL=

# OpenRouter free router only; key remains server-side.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Email verification/recovery. Remove temporary ALLOW_UNVERIFIED_SIGNUP after SMTP works.
ALLOW_UNVERIFIED_SIGNUP=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional payment provider.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_MODE=off
YOOKASSA_MERCHANT_TYPE=self_employed
# In test mode only this verified account can open sandbox checkout.
YOOKASSA_TEST_EMAIL=

UPLOAD_DIR=./data/uploads

# Optional server-side Upstash Redis coordination. PostgreSQL remains the source of truth.
REDIS_ENABLED=auto
REDIS_ENV=development
REDIS_KV_REST_API_URL=
REDIS_KV_REST_API_TOKEN=

# Optional MyTracker server-to-server conversion reporting. Create an S2S API key in MyTracker.
# MYTRACKER_S2S_APP_ID is the numeric MyTracker application id, not the Android SDK_KEY.
MYTRACKER_S2S_APP_ID=
MYTRACKER_S2S_KEY=
